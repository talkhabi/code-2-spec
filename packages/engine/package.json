{
  "name": "code2spec",
  "version": "0.2.2",
  "description": "Turn legacy codebases into specs, journeys, Gherkin scenarios and Playwright tests for AI-driven rebuilds.",
  "keywords": [
    "legacy",
    "spec",
    "reverse-engineering",
    "migration",
    "rewrite",
    "gherkin",
    "playwright",
    "claude",
    "ai",
    "vue",
    "typescript"
  ],
  "homepage": "https://github.com/talkhabi/code-2-spec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkhabi/code-2-spec.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/talkhabi/code-2-spec/issues"
  },
  "type": "module",
  "bin": {
    "code2spec": "dist/cli.js",
    "code2spec-mcp": "dist/mcp.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "cp ../../README.md README.md",
    "prepublishOnly": "pnpm --dir ../.. build && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@fastify/static": "^10.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vue/compiler-sfc": "^3.5.44",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.7",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
